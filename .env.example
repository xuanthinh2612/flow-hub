# Flow Hub — copy to .env and adjust. Everything here is optional.

# Bind address. 127.0.0.1 = this machine only (auth off by default).
# 0.0.0.0 = reachable from other machines (auth turns on automatically).
FLOWHUB_HOST=127.0.0.1
FLOWHUB_PORT=8787

# SQLite database + downloaded media.
FLOWHUB_DATA_DIR=./data

# Token the extension pairs with. Empty = generated on first start (see Settings page).
FLOWHUB_WORKER_TOKEN=rCQtjrqbgivY-62MBbV53jse2OFAR8KU

# Key other servers send as X-API-Key. Empty = generated and printed at startup.
FLOWHUB_API_KEY=frXPamwfH4LTzsbqPHLbj4lcOgajyG1c

# auto | on | off  (auto = on unless bound to localhost)
FLOWHUB_AUTH=auto
